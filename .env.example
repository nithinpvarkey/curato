# Copy this file to .env.local and fill in real values.
# Never put real secrets in this file — it is committed to version control.

# App
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-random-secret

# Supabase — find these in your project dashboard under Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-public-key-here
# WARNING: SUPABASE_SECRET_KEY bypasses Row Level Security — server-only, never expose to the browser
SUPABASE_SECRET_KEY=your-service-role-key-here

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/curato

# External APIs (add keys as needed)
# SOME_API_KEY=your-api-key-here
