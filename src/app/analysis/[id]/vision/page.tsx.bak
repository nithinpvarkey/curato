import { redirect, notFound } from 'next/navigation'
import Link from 'next/link'
import { createClient } from '@/lib/supabase/server'
import StyleOptionTabs from
  '@/components/analysis/StyleOptionTabs'
import { getBestButtonColour } from '@/lib/colour-utils'
import { getCategoryConfig } from '@/lib/category-config'
import {
  parseBudgetRange,
  getCategoryBudgetAllocation,
} from '@/lib/budget-utils'
import type { QuizAnswers, CategoryAnalysis } from
  '@/types/analysis'
import type { MasterStyleOption } from '@/types/analysis'

export const dynamic = 'force-dynamic'

type PageProps = {
  params: Promise<{ id: string }>
}

function isValidUUID(value: string): boolean {
  return /^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(value)
}

const CATEGORY_KEYS = [
  'flowers_d_cor',
  'venue_atmosphere',
  'photography_lighting',
  'attire_styling',
] as const

function normaliseHex(hex: string): string {
  return hex.startsWith('#') ? hex : `#${hex}`
}

function PickStylePrompt({ id }: { id: string }) {
  return (
    <main className="min-h-screen bg-background">
      <div className="max-w-2xl mx-auto px-4 py-8">
        <div className="rounded-2xl border border-border/50
        bg-[#FDFAF7] p-6 text-center space-y-3">
          <p className="text-sm font-medium text-foreground">
            Pick your style first
          </p>
          <p className="text-xs text-muted-foreground
          leading-relaxed">
            Choose one of your four style options on
            the analysis page to see your full vision.
          </p>
          <Link
            href={`/analysis/${id}`}
            className="inline-block mt-2 text-sm underline
            text-foreground/70 hover:text-foreground
            transition-colors"
          >
            ← Go to your analysis
          </Link>
        </div>
      </div>
    </main>
  )
}

export default async function VisionPage({
  params,
}: PageProps) {
  const { id } = await params

  if (!isValidUUID(id)) notFound()

  const supabase = await createClient()
  const {
    data: { user },
    error: authError,
  } = await supabase.auth.getUser()
  if (authError || !user) redirect('/login')

  const { data: analysis, error: dbError } =
    await supabase
      .from('analyses')
      .select('*')
      .eq('id', id)
      .eq('user_id', user.id)
      .single()

  if (dbError || !analysis) notFound()

  const chosenId =
    analysis.chosen_master_option_id as number | null
  const masterResults =
    analysis.master_results as
      { options: MasterStyleOption[] } | null

  if (!chosenId || !masterResults) {
    return <PickStylePrompt id={id} />
  }

  const chosenOption = masterResults.options.find(
    o => o.id === chosenId
  )
  if (!chosenOption) {
    return <PickStylePrompt id={id} />
  }

  // Quiz answers — latest partner_a response
  const { data: quizData } = await supabase
    .from('quiz_responses')
    .select('answers')
    .eq('analysis_id', id)
    .eq('respondent', 'partner_a')
    .order('created_at', { ascending: false })
    .limit(1)
    .single()

  const defaultQuiz: QuizAnswers = {
    wedding_month: null,
    wedding_year: null,
    guest_count: null,
    budget_range: null,
  }
  const quizAnswers: QuizAnswers =
    (quizData?.answers as QuizAnswers) ?? defaultQuiz

  const categoryBriefs =
    analysis.category_briefs as
      Record<string, CategoryAnalysis> | null

  const palette = chosenOption.master_palette.map(c => ({
    ...c,
    hex: normaliseHex(c.hex),
  }))

  const masterAccent = getBestButtonColour(palette)

  const hasBudget = !!quizAnswers.budget_range
  const totalBudget = parseBudgetRange(
    quizAnswers.budget_range
  )

  return (
    <main className="min-h-screen bg-background">
      <div className="max-w-2xl mx-auto
      px-4 py-8 space-y-8">

        {/* Back link */}
        <Link
          href={`/analysis/${id}`}
          className="inline-flex items-center gap-1
          text-sm text-muted-foreground
          hover:text-foreground transition-colors"
        >
          ← Change your style
        </Link>

        {/* ── HEADER CARD ── */}
        <div className="rounded-2xl border
        border-border/50 bg-[#FDFAF7] overflow-hidden">

          {/* Palette strip */}
          <div className="flex w-full">
            {palette.slice(0, 5).map(c => (
              <div
                key={c.hex}
                className="flex-1 h-3"
                style={{ backgroundColor: c.hex }}
              />
            ))}
          </div>

          <div className="px-5 pt-5 pb-6 space-y-4">

            {/* Style name */}
            <div>
              <p className="text-[10px] font-semibold
              uppercase tracking-widest
              text-muted-foreground/50 mb-1">
                Your master style
              </p>
              <h1 className="text-2xl font-semibold
              text-foreground leading-snug">
                {chosenOption.name}
              </h1>
            </div>

            {/* Why this fits */}
            <div
              className="rounded-xl p-4"
              style={{
                backgroundColor: `${masterAccent}10`
              }}
            >
              <p
                className="text-[10px] font-semibold
                uppercase tracking-widest mb-2"
                style={{ color: masterAccent }}
              >
                Why this fits your saves
              </p>
              <p className="text-sm
              text-foreground/80 leading-relaxed">
                {chosenOption.why_your_style}
              </p>
            </div>

            {/* Behavioral description */}
            <p className="text-sm text-foreground/80
            leading-relaxed">
              {chosenOption.behavioral_description}
            </p>

            {/* Signal evidence */}
            <p className="text-xs text-muted-foreground
            leading-relaxed italic">
              {chosenOption.signal_evidence}
            </p>

            {/* Labeled palette */}
            <div>
              <p className="text-[10px] font-semibold
              uppercase tracking-widest
              text-muted-foreground/60 mb-2">
                Your master palette
              </p>
              <div className="flex w-full gap-1 mb-1">
                {palette.map(c => (
                  <div
                    key={c.hex}
                    className="flex-1 h-8 rounded-lg"
                    style={{ backgroundColor: c.hex }}
                    title={c.name}
                  />
                ))}
              </div>
              <div className="flex w-full gap-1">
                {palette.map(c => (
                  <p
                    key={c.hex}
                    className="flex-1 text-[9px]
                    text-muted-foreground/60
                    text-center truncate"
                  >
                    {c.name}
                  </p>
                ))}
              </div>
            </div>

          </div>
        </div>

        {/* ── BUDGET SECTION ── */}
        <div className="rounded-2xl border
        border-border/50 bg-[#FDFAF7] p-5 space-y-4">

          <div>
            <p className="text-[10px] font-semibold
            uppercase tracking-widest
            text-muted-foreground/50 mb-1">
              Budget overview
            </p>
            <p className="text-xs
            text-muted-foreground/70 leading-relaxed">
              Typical allocation for your budget —
              not actual costs
            </p>
          </div>

          {hasBudget ? (
            <div className="space-y-4">
              <div className="flex items-center
              justify-between">
                <span className="text-xs
                text-muted-foreground">
                  Total budget
                </span>
                <span className="text-xs font-semibold
                text-foreground">
                  {quizAnswers.budget_range}
                </span>
              </div>

              {CATEGORY_KEYS.map((key, i) => {
                const config = getCategoryConfig(key)
                const alloc = getCategoryBudgetAllocation(
                  totalBudget, key
                )
                const barColor =
                  palette[i % palette.length]?.hex ??
                  masterAccent
                const pctMin = parseInt(
                  alloc.percentage.split('–')[0]
                )
                return (
                  <div key={key} className="space-y-1.5">
                    <div className="flex items-center
                    justify-between gap-2">
                      <span className="text-xs
                      text-foreground/80">
                        {config.emoji} {config.name}
                      </span>
                      <span className="text-xs
                      font-semibold text-foreground/70
                      flex-shrink-0 tabular-nums">
                        {alloc.formatted}
                        <span className="font-normal
                        text-muted-foreground/50 ml-1">
                          ({alloc.percentage})
                        </span>
                      </span>
                    </div>
                    <div className="h-2 bg-muted/30
                    rounded-full overflow-hidden">
                      <div
                        className="h-full rounded-full"
                        style={{
                          backgroundColor: barColor,
                          width: `${pctMin}%`,
                        }}
                      />
                    </div>
                  </div>
                )
              })}
            </div>
          ) : (
            <p className="text-sm
            text-muted-foreground leading-relaxed">
              Add your budget on the{' '}
              <Link
                href={`/analysis/${id}`}
                className="underline text-foreground/70
                hover:text-foreground transition-colors"
              >
                analysis page
              </Link>{' '}
              to see the breakdown.
            </p>
          )}
        </div>

        {/* ── CATEGORY SECTIONS ── */}
        {CATEGORY_KEYS.map(categoryKey => {
          const config = getCategoryConfig(categoryKey)
          const briefKey = `${chosenId}_${categoryKey}`
          const brief = categoryBriefs?.[briefKey]
          const option = brief?.options?.[0]

          return (
            <div key={categoryKey} className="space-y-3">

              {/* Category header */}
              <div className="flex items-center gap-2">
                <span className="text-xl leading-none">
                  {config.emoji}
                </span>
                <h2 className="text-base font-semibold
                text-foreground">
                  {config.name}
                </h2>
              </div>

              {option ? (
                <div className="rounded-2xl border
                border-border/50 bg-[#FDFAF7]
                px-4 pt-2 pb-4">
                  <StyleOptionTabs
                    option={{
                      ...option,
                      palette: option.palette.map(c => ({
                        ...c,
                        hex: normaliseHex(c.hex),
                      })),
                    }}
                    accentHex={getBestButtonColour(
                      option.palette.map(c => ({
                        ...c,
                        hex: normaliseHex(c.hex),
                      }))
                    )}
                    quizAnswers={quizAnswers}
                    personalisedResult={null}
                    isPersonalising={false}
                    categoryKey={categoryKey}
                  />
                </div>
              ) : (
                <div className="rounded-2xl border
                border-border/50 bg-[#FDFAF7] p-5">
                  <p className="text-sm
                  text-muted-foreground leading-relaxed">
                    Not generated yet —{' '}
                    <Link
                      href={`/analysis/${id}`}
                      className="underline text-foreground/70
                      hover:text-foreground transition-colors"
                    >
                      open this category on your
                      analysis page
                    </Link>{' '}
                    to generate it.
                  </p>
                </div>
              )}

            </div>
          )
        })}

      </div>
    </main>
  )
}
